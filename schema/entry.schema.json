{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/satchellhong/eigenmol-plugin-catalog/main/schema/entry.schema.json",
  "title": "EigenMol plugin catalog entry",
  "description": "One file in plugins/, named <id>.json. tools/catalog.py applies these rules and a few the schema cannot express (the file name, unique versions, a note when a run uses the network).",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schema_version", "id", "name", "summary", "publisher", "category", "license", "source_repository", "network", "releases"],
  "properties": {
    "format": { "const": "eigenmol-plugin-catalog-entry" },
    "schema_version": { "const": 1 },
    "id": {
      "description": "The id in the plugin's manifest (plugin.json), exactly.",
      "type": "string",
      "maxLength": 128,
      "pattern": "^[a-z0-9_-]+(\\.[a-z0-9_-]+)+$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "summary": { "description": "One sentence: what it computes.", "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "maxLength": 4000 },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "category": { "enum": ["docking", "energy", "structure-prediction", "analysis", "preparation", "utility", "example"] },
    "license": { "description": "The plugin's licence: an SPDX identifier, or `proprietary`.", "type": "string", "minLength": 1 },
    "homepage": { "type": "string", "pattern": "^https://" },
    "source_repository": { "type": "string", "pattern": "^https://" },
    "status": { "enum": ["active", "deprecated"], "default": "active" },
    "network": {
      "description": "What the publisher declares about network use. A declaration; EigenMol does not observe a plugin's traffic.",
      "type": "object",
      "additionalProperties": false,
      "required": ["setup", "runs"],
      "properties": {
        "setup": { "description": "The setup downloads something (an environment, an engine).", "type": "boolean" },
        "runs": { "description": "A run sends data to a remote service.", "type": "boolean" },
        "note": { "description": "What is sent, and where. Required when runs is true.", "type": "string" }
      }
    },
    "releases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "url", "sha256", "platforms", "plugin_spec", "published"],
        "properties": {
          "version": { "description": "The version in the package's manifest, exactly.", "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.+-]*)?$" },
          "url": { "description": "The package itself: a GitHub release asset or another permanent HTTPS address of a .zip.", "type": "string", "pattern": "^https://[^?#]+\\.zip$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size": { "type": "integer", "minimum": 1 },
          "platforms": {
            "description": "Empty means any platform.",
            "type": "array",
            "items": { "type": "string", "pattern": "^(macos|windows|linux)(-(arm64|x86_64))?$" }
          },
          "plugin_spec": { "description": "The EigenMol plugin specification the package declares (spec_version).", "type": "string", "pattern": "^\\d+\\.\\d+$" },
          "published": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    }
  }
}
